FROM python:3.12-slim
ENV PYTHONDONTWRITEBYTECODE=1 PYTHONUNBUFFERED=1
WORKDIR /app
COPY backend/requirements.txt ./
RUN pip install --no-cache-dir -r requirements.txt && \
    groupadd --gid 10001 commitflow && useradd --uid 10001 --gid commitflow --create-home commitflow
COPY --chown=commitflow:commitflow backend/ ./
RUN chown commitflow:commitflow /app
USER commitflow
EXPOSE 8000
CMD ["gunicorn", "commitflow.wsgi:application", "--bind", "0.0.0.0:8000", "--workers", "2", "--threads", "4", "--timeout", "120", "--access-logfile", "-", "--error-logfile", "-"]
