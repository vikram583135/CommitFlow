# Local development defaults. Generate new secrets before production deployment.
DEBUG=True
DJANGO_SECRET_KEY=
FIELD_ENCRYPTION_KEY=
FRONTEND_URL=http://localhost:3000
ALLOWED_HOSTS=localhost,127.0.0.1,backend

POSTGRES_DB=commitflow
POSTGRES_USER=commitflow_user
POSTGRES_PASSWORD=change-this-local-password
POSTGRES_HOST=postgres
POSTGRES_PORT=5432
REDIS_URL=redis://redis:6379/1
CELERY_BROKER_URL=redis://redis:6379/0
CELERY_RESULT_BACKEND=redis://redis:6379/0

GITHUB_APP_ID=
GITHUB_APP_NAME=commitflow-bot
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
GITHUB_WEBHOOK_SECRET=
GITHUB_PRIVATE_KEY_PATH=
GITHUB_PRIVATE_KEY=
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Development emails appear in backend logs. Set SMTP configuration in production.
EMAIL_HOST=
EMAIL_PORT=587
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
EMAIL_USE_TLS=True
DEFAULT_FROM_EMAIL=CommitFlow <noreply@localhost>
API_TOKEN_TTL=86400
MAX_DAILY_EXECUTIONS=20

# Optional Python unittest container validation. Requires a dedicated Docker runtime.
ENABLE_PYTHON_SANDBOX=False
PYTHON_SANDBOX_IMAGE=python:3.12-slim

# Tunnel starts only with the explicit "tunnel" Compose profile.
CLOUDFLARE_TUNNEL_TOKEN=
